# Copy this file to .env and set real values (cp .env.example .env)
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change_me
# API service (Fleet Metrics data source: TimescaleDB continuous aggregates)
DATABASE_URL=postgres://litellm:change_me@localhost:5432/litellm
API_PORT=8080
# --- TTFT/ghost classifier (API service; verdicts in ttft_classification) ---
# Estimated uncovered-TTFT share, in percent of a backend's decode seconds,
# above which the backend's decode buckets get the TTFT estimate subtracted.
# Backends at or below the threshold keep their raw denominator (margin of
# error). 0 corrects every backend with any uncovered TTFT; a huge value
# (e.g. 1e9) disables the correction entirely. Default 2.
TTFT_CORRECTION_THRESHOLD_PCT=2
# Classifier cadence in minutes (default 120 = every 2 hours). 0 disables the
# periodic run; the start run and the inventory watch remain.
TTFT_CLASSIFIER_INTERVAL_MIN=120
# How far back the classifier measures each backend, in minutes (default 1440
# = 24h of streaming/non-streaming traffic mix).
TTFT_CLASSIFIER_WINDOW_MIN=1440
# How often the classifier polls the deployment_inventory fingerprint for a
# new/updated model at LiteLLM, in seconds (default 60). 0 disables the watch.
TTFT_CLASSIFIER_WATCH_S=60
# Scraper-liveness threshold in ms. The code default remains 75000, but compose
# and this example use 30000: the scraper now writes a liveness heartbeat every
# tick regardless of target outcome, so the signal no longer starves during a
# target outage. Do not lower below 30s.
SCRAPE_DOWN_AFTER_MS=30000
# Frontend dev proxy target (inside compose this is http://api:8080)
API_PROXY_TARGET=http://localhost:8080
# Set to true to use the legacy Vite mock data plugin instead of the real API
MOCK_API=false
# --- Vite client flags (Vite only forwards VITE_-prefixed vars to the browser) ---
# VITE_DEBUG toggles the debug-only "unassigned" card in the fleet metrics panel.
# Treated as ON when "1" or "true", and ON when unset; set 0 to hide the card.
# NOTE: docker-compose.yml sets VITE_DEBUG=1 directly on the web service.
VITE_DEBUG=1
# Optional: how many cards the fleet panel renders per section. Default and
# maximum are 20, matching the API's default top-N.
VITE_TOP_N=20
# "by lessing.systems" credit in the dashboard header (on by default).
# docker-compose.yml maps SHOW_CREDIT -> VITE_SHOW_CREDIT on the web service;
# set it to false/0/off/no to hide the credit.
SHOW_CREDIT=true
# Browser-tab icon (independent of SHOW_CREDIT). Leave empty for the
# lessing.systems "L" mark, set NONE for no icon, or give your own icon's URL or
# path, e.g. /my-icon.png (placed in apps/web/public) or https://example.com/icon.svg.
FAVICON=

# Your LiteLLM proxy key (the scraper reads it via config/targets.yaml `key_env`).
LITELLM_MASTER_KEY=sk-change-me

# Your tensorfold inference server key (the scraper reads it via the
# config/targets.yaml tensorfold entry's `key_env`). The loader requires every
# target's key_env variable to be set and non-blank, so leave a placeholder
# here even if your tensorfold /metrics endpoint needs no auth.
TENSORFOLD_API_KEY=change_me

# Scraper target list. SCRAPER_TARGETS names the targets YAML file the scraper
# loads; docker-compose.yml already sets SCRAPER_TARGETS=/config/targets.yaml
# (it mounts ./config at /config), so only override it for a custom path.
# config/targets.yaml is the multi-target list — every target needs name, url
# and key_env, and each key_env variable must be set in this file. Shipped
# placeholders only — edit for your deployment:
#   backends:
#     - name: primary
#       url: http://litellm.example.com:4000/metrics/
#       key_env: LITELLM_MASTER_KEY
#     - name: tensorfold
#       url: http://tensorfold.example.com:8888/metrics
#       key_env: TENSORFOLD_API_KEY
